
var minimumSumSubarray = function(nums, l, r) {
    let minSum = Infinity;

    for (let i = 0; i < nums.length; i++) {
        let sum = 0;

        for (let j = i; j < nums.length; j++) {
            sum += nums[j];

            let len = j - i + 1;

            if (len >= l && len <= r && sum > 0) {
                minSum = Math.min(minSum, sum);
            }
        }
    }

    return minSum === Infinity ? -1 : minSum;
};
